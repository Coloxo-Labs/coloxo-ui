          "target": "input/input.module.css"
        },
        {
          "path": "packages/ui/src/components/Input/InputGroup.tsx",
          "target": "input/input-group.tsx"
        },
        {
          "path": "packages/ui/src/components/Input/InputGroup.module.css",
          "target": "input/input-group.module.css"
        },
        {
          "path": "packages/ui/src/components/Input/index.ts",
          "target": "input/index.ts"
        }
      ],
      "dependencies": [],
      "registryDependencies": [
        "utils",
