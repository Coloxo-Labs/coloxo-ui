{
  "name": "Input",
  "slug": "input",
  "type": "registry:ui",
  "category": "Forms",
  "description": "Text input with label, hint, error, icons, and size variants.",
  "status": "stable",
  "version": "1.0.0",
  "dependencies": [],
  "registryDependencies": [
    "utils",
    "styles",
    "theme",
    "form-control",
    "form-field",
    "icon",
    "tooltip",
    "icons"
  ],
  "providers": ["theme"],
  "accessibility": {
    "keyboard": true,
    "aria": true,
    "notes": "Labelled via FormField; errors use aria-invalid and role=alert."
  },
  "docs": {
    "usage": "<Input label=\"Email\" placeholder=\"you@company.com\" />"
  },
  "styles": {
