    "coloxo-css": {
      "files": [
        {
          "path": "packages/ui/src/components/IconButton/IconButton.module.css",
          "target": "icon-button/icon-button.module.css"
        },
        {
          "path": "packages/ui/src/components/IconButton/IconButton.tsx",
          "target": "icon-button/icon-button.tsx"
        },
        {
          "path": "packages/ui/src/components/IconButton/index.ts",
          "target": "icon-button/index.ts"
        }
      ],
      "dependencies": ["@radix-ui/react-tooltip"],
      "registryDependencies": [
        "utils",
        "icon",
        "form-control",
        "button-variants",
