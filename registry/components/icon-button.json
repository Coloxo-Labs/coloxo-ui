      "files": [
        {
          "path": "registry/styles/icon-button.tsx",
          "target": "icon-button.tsx"
        }
      ],
      "dependencies": ["@radix-ui/react-tooltip"],
      "registryDependencies": ["utils", "icon", "form-control", "tooltip"]
