{
  "name": "IconButton",
  "slug": "icon-button",
  "type": "registry:ui",
  "category": "General",
  "description": "Icon-only button with tooltip, loading, and variant styles.",
  "status": "stable",
  "version": "1.0.0",
  "providers": ["theme"],
  "accessibility": {
    "keyboard": true,
    "aria": true
  },
  "styles": {
