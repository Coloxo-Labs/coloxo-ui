{
  "name": "CodeBlock",
  "slug": "code-block",
  "type": "registry:ui",
  "category": "General",
  "description": "Self-contained code display with built-in syntax highlighting — no Prism, Shiki, or Highlight.js.",
  "status": "stable",
  "version": "1.0.0",
  "providers": [
    "theme"
  ],
  "accessibility": {
    "keyboard": true,
    "aria": true,
    "notes": "Copy button with polite live region; line numbers excluded from clipboard."
  },
  "docs": {
    "usage": "<CodeBlock language=\"typescript\" showLineNumbers code={code} />"
  },
