{
  "name": "@coloxo/cli",
  "version": "1.0.5",
  "description": "Premium Coloxo UI CLI — copy components into your project (CSS Modules or Tailwind)",
  "type": "module",
  "bin": {
    "coloxo": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coloxo-Labs/coloxo-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://ui.coloxolabs.com",
  "bugs": {
    "url": "https://github.com/Coloxo-Labs/coloxo-ui/issues"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fs-extra": "^11.3.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vitest": "^3.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
